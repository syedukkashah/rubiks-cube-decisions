OPENROUTER_API_KEY=
CORS_ORIGINS=http://localhost:5173
MOCK_MODELS=true
# Default 1.10. Values up to 2.00 are accepted only because the human approved a $2
# ceiling for one live session on 2026-10-25 (scripts/run_live_session.ps1 sets it
# per process). Values above 2.00 are rejected.
MAX_SPEND_USD=1.10
MAX_TRIAL_RETRIES=3
MAX_LIVE_CALLS=2000
CHAT_MAX_TOKENS=160
CHAT_REASONING_EFFORT=low
MAX_TIMEOUT_S=20
MAX_RETRIES_CAP=1
# Relative paths resolve from backend/, regardless of the working directory.
SPEND_LEDGER_PATH=.spend/ledger.jsonl
RUNS_DIR=.runs
ALLOW_LIVE_RERUN=false
RECORDING_PATH=recordings/benchmark.json
EXPECTED_COST_WARMUP=0.03
EXPECTED_COST_PRIMARY=0.33
EXPECTED_COST_EXTENSION=0.20
# stop (default): the opus_truncation gate stops a live session. report: the reason is
# still computed and recorded in runs[].gate but does not stop it; other gates still stop.
OPUS_TRUNCATION_GATE=stop
