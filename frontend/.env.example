# Copy to .env (or .env.local) and fill in. Everything prefixed VITE_ ends up in the browser bundle,
# so never put secrets here. The OpenRouter key lives only in backend/.env.

# Backend API base path. With the dev server this is proxied to BACKEND_URL.
VITE_API_BASE_URL=/api/v1

# true = serve every endpoint from the shared /contract/fixtures; no backend needed.
VITE_USE_MOCKS=false

# Mock-only:
#   default          a live recording exists: "Run full benchmark" replays it (no OpenRouter calls)
#   no_recording     no recording yet and no key: "Run full benchmark" simulates
#   live_ready       key configured, no recording: "Run live once" is offered and saves a recording
#   gate_stop        like live_ready, but the warm-up step's gate fails and stops the session
#   missing_api_key  backend has no OPENROUTER_API_KEY (POST /runs -> 503)
#   spend_cap        spend pre-check fails (POST /runs and live sessions -> 409 with cost details)
#   run_abort        a custom run is aborted mid-way: "Live spend cap reached", run failed
VITE_MOCK_SCENARIO=default

# Shown on every screen for the submission recording (AGENTS.md section 9, item 8).
VITE_STUDENT_NAME=
VITE_STUDENT_ROLL=

# Dev-server only (not exposed to the browser): where /api is proxied to.
BACKEND_URL=http://localhost:8000
